{
  "note": "Receitas prontas do hub (Activepieces). Nomes conferidos no código das pieces. Ações: executar com ap_run_action; se reclamar de um campo, confira com ap_get_piece_props (1 chamada) e ajuste.",
  "actions": [
    {"id": "gmail_find", "title": "Ler/buscar e-mails do Gmail", "piece": "@activepieces/piece-gmail", "action": "gmail_search_mail",
     "input": {"from": "", "subject": "", "content": "", "after_date": "AAAA-MM-DDT00:00:00Z", "max_results": 10},
     "tip": "Campos vazios podem ser omitidos. Use after_date para 'hoje'/'últimos dias' e max_results 5–10.",
     "keywords": ["email", "e-mail", "emails", "e-mails", "gmail", "inbox", "caixa de entrada", "ler", "leia", "busque", "buscar", "procure"]},
    {"id": "gmail_send", "title": "Enviar e-mail pelo Gmail", "piece": "@activepieces/piece-gmail", "action": "send_email",
     "input": {"receiver": ["destino@exemplo.com"], "subject": "Assunto", "body_type": "plain_text", "body": "Texto"},
     "tip": "receiver é uma lista. body_type: plain_text ou html.",
     "keywords": ["envie", "enviar", "mande", "mandar", "responda", "email", "e-mail", "gmail"]},
    {"id": "github_issue", "title": "Criar issue no GitHub", "piece": "@activepieces/piece-github", "action": "github_create_issue",
     "input": {"repository": "<valor de ap_resolve_property_options para 'repository'>", "title": "Título", "description": "Detalhes"},
     "tip": "repository é um dropdown: pegue o valor exato com ap_resolve_property_options.",
     "keywords": ["github", "issue", "bug", "repositorio", "repo"]},
    {"id": "sheets_add_row", "title": "Adicionar linha no Google Planilhas", "piece": "@activepieces/piece-google-sheets", "action": "insert_row",
     "input": {"spreadsheet_id": "<id da planilha>", "sheet_id": 0, "values": {"A": "valor", "B": "valor"}},
     "tip": "spreadsheet_id/sheet_id: use ap_resolve_property_options se não souber.",
     "keywords": ["planilha", "planilhas", "sheets", "google sheets", "linha", "adicione", "registre"]},
    {"id": "sheets_find_rows", "title": "Buscar linhas no Google Planilhas", "piece": "@activepieces/piece-google-sheets", "action": "sheets_find_rows",
     "input": {"spreadsheet_id": "<id>", "sheet_id": 0, "column_name": "A", "search_value": "texto", "number_of_rows": 20},
     "tip": "Peça poucas linhas (number_of_rows).",
     "keywords": ["planilha", "planilhas", "sheets", "procure", "buscar", "encontre", "linhas"]},
    {"id": "slack_send", "title": "Enviar mensagem num canal do Slack", "piece": "@activepieces/piece-slack", "action": "send_channel_message",
     "input": {"channel": "<id do canal via ap_resolve_property_options>", "text": "Mensagem"},
     "tip": "channel é dropdown: valor exato via ap_resolve_property_options.",
     "keywords": ["slack", "canal", "mensagem"]},
    {"id": "calendar_events", "title": "Listar eventos do Google Agenda", "piece": "@activepieces/piece-google-calendar", "action": "google_calendar_list_events",
     "input": {},
     "tip": "Confira os campos de período com ap_get_piece_props.",
     "keywords": ["agenda", "calendario", "calendar", "eventos", "compromissos", "reuniao", "reunioes"]},
    {"id": "notion_page", "title": "Criar página no Notion", "piece": "@activepieces/piece-notion", "action": "notion_create_page",
     "input": {"parent_page_id": "<id da página pai>", "title": "Título", "content": "Conteúdo"},
     "tip": "parent_page_id via ap_resolve_property_options.",
     "keywords": ["notion", "pagina", "nota", "anotacao"]}
  ],
  "triggers": [
    {"id": "every_day", "title": "Todo dia num horário", "piece": "@activepieces/piece-schedule", "trigger": "every_day", "input": {"hour_of_the_day": 8, "timezone": "America/Sao_Paulo", "run_on_weekends": true}},
    {"id": "every_x_minutes", "title": "A cada X minutos", "piece": "@activepieces/piece-schedule", "trigger": "every_x_minutes", "input": {"minutes": 15}},
    {"id": "every_week", "title": "Toda semana", "piece": "@activepieces/piece-schedule", "trigger": "every_week", "input": {"day_of_the_week": 1, "hour_of_the_day": 9, "timezone": "America/Sao_Paulo"}},
    {"id": "gmail_new_email", "title": "Quando chegar e-mail novo", "piece": "@activepieces/piece-gmail", "trigger": "gmail_new_email_received", "input": {}},
    {"id": "webhook", "title": "Quando receber uma chamada HTTP", "piece": "@activepieces/piece-webhook", "trigger": "catch_webhook", "input": {}}
  ]
}
